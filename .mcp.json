{
  "mcpServers": {
    "marketlab": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "marketlab-mcp",
        "marketlab-mcp",
        "--workspace-root",
        "/app/workspace",
        "--artifact-root",
        "/app/artifacts",
        "--repo-root",
        "/app/repo"
      ]
    },
    "marketlab-online": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "marketlab-mcp",
        "marketlab-mcp",
        "--workspace-root",
        "/app/workspace",
        "--artifact-root",
        "/app/artifacts",
        "--repo-root",
        "/app/repo",
        "--allow-network"
      ]
    }
  }
}
