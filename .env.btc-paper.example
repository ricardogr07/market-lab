# BTC paper deployment uses a separate Alpaca paper account, LLM keys, and Telegram chat.
MARKETLAB_ENV_FILE=.env.btc-paper

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex
ALPACA_TIMEOUT_SECONDS=30

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MARKETLAB_PAPER_TELEGRAM_ENABLED=true
MARKETLAB_PAPER_TELEGRAM_ALLOWED_EXPERIMENTS=btc_paper_daily

MARKETLAB_UID=1000
MARKETLAB_GID=1000
